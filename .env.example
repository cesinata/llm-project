# Pick one provider: groq, gemini, anthropic or ollama.
LLM_PROVIDER=groq

# Only the key for the provider you picked is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the provider's default model.
# LLM_MODEL=openai/gpt-oss-120b

# Optional: path to the DuckDB warehouse built by `crashsql load` + `dbt build`.
# CRASHSQL_DB=data/warehouse.duckdb

# Optional: Snowflake target for `crashsql build --target snowflake`.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_HOST=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_PASSWORD=
